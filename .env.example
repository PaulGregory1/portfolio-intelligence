# Any OpenAI-compatible endpoint works. Default: NVIDIA API catalog (build.nvidia.com).
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=
# Pick a model that supports tool calling: run `pi models` to list what the endpoint serves.
LLM_MODEL=
LLM_TEMPERATURE=0.2
LLM_MAX_CONCURRENCY=2
LLM_MAX_TOKENS=2048
# USD per million tokens, used for cost estimates in evaluation reports (0 = free tier).
LLM_PRICE_INPUT_PER_MTOK=0
LLM_PRICE_OUTPUT_PER_MTOK=0
